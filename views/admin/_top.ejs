<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · Yönetim · <%= settings.site_name %></title>
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Manrope:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body class="admin">
<% if (admin) { %>
<div class="adm">
  <aside class="adm-side" data-side>
    <a class="adm-logo" href="/admin">
      <span class="adm-logo__name"><%= settings.site_name %></span>
      <span class="adm-logo__tag">Yönetim Paneli</span>
    </a>
    <nav class="adm-nav" aria-label="Yönetim menüsü">
      <a href="/admin" class="<%= path === '/admin' ? 'is-active' : '' %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>Genel Bakış</a>
      <a href="/admin/urunler" class="<%= path.startsWith('/admin/urunler') ? 'is-active' : '' %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5V8z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>Ürünler</a>
      <a href="/admin/kategoriler" class="<%= path.startsWith('/admin/kategoriler') ? 'is-active' : '' %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>Kategoriler</a>
      <a href="/admin/talepler" class="<%= path.startsWith('/admin/talepler') ? 'is-active' : '' %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3z"/></svg>Özel Talepler
        <% if (newRequests) { %><span class="adm-count"><%= newRequests %></span><% } %></a>
      <a href="/admin/ayarlar" class="<%= path.startsWith('/admin/ayarlar') ? 'is-active' : '' %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>Site Ayarları</a>
    </nav>
    <div class="adm-side__foot">
      <a class="adm-view-site" href="/" target="_blank" rel="noopener">Siteyi görüntüle ↗</a>
      <div class="adm-user">
        <span class="adm-user__avatar"><%= admin.username.slice(0, 1).toUpperCase() %></span>
        <span class="adm-user__name"><%= admin.username %></span>
      </div>
      <div class="adm-user__actions">
        <a href="/admin/parola">Parola</a>
        <form method="post" action="/admin/cikis">
          <input type="hidden" name="_csrf" value="<%= csrf() %>">
          <button type="submit">Çıkış yap</button>
        </form>
      </div>
    </div>
  </aside>

  <div class="adm-main">
    <header class="adm-topbar">
      <button class="adm-burger" type="button" aria-label="Menü" data-side-toggle>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
      <h1 class="adm-title"><%= title %></h1>
      <div class="adm-topbar__actions"><%- locals.actions || '' %></div>
    </header>
    <main class="adm-content">
      <% if (flash) { %><div class="adm-alert adm-alert--<%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
<% } %>
