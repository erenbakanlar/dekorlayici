<% if (settings.announcement) { %>
<div class="announce">
  <div class="container announce__inner">
    <span class="announce__text"><%- include('icon', { name: 'sparkle', size: 14 }) %> <%= settings.announcement %></span>
    <div class="announce__links">
      <% if (settings.phone) { %><a href="tel:<%= settings.phone.replace(/[^\d+]/g, '') %>"><%= settings.phone %></a><% } %>
      <% if (igUrl) { %><a href="<%= igUrl %>" target="_blank" rel="noopener noreferrer">@<%= settings.instagram %></a><% } %>
    </div>
  </div>
</div>
<% } %>

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <button class="icon-btn nav-toggle" type="button" aria-label="Menüyü aç" aria-expanded="false" aria-controls="mobil-menu" data-nav-toggle>
      <%- include('icon', { name: 'menu', size: 24 }) %>
    </button>

    <a class="logo" href="/" aria-label="<%= settings.site_name %> ana sayfa">
      <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M8 36V18a12 12 0 0 1 24 0v18" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M14 36V20a6 6 0 0 1 12 0v16" fill="none" stroke="currentColor" stroke-width="2.4" opacity=".55"/><circle cx="20" cy="9" r="2" fill="currentColor"/></svg>
      <span class="logo__text"><%= settings.site_name %></span>
    </a>

    <nav class="main-nav" aria-label="Ana menü">
      <a href="/" class="<%= path === '/' ? 'is-active' : '' %>">Ana Sayfa</a>
      <div class="main-nav__drop">
        <a href="/urunler" class="<%= path.startsWith('/urun') ? 'is-active' : '' %>">Ürünler <%- include('icon', { name: 'chevron', size: 14 }) %></a>
        <div class="dropdown">
          <a href="/urunler">Tüm Ürünler</a>
          <% navCategories.forEach((c) => { %><a href="/urunler?kategori=<%= c.slug %>"><%= c.name %></a><% }) %>
        </div>
      </div>
      <a href="/kisiye-ozel" class="<%= path === '/kisiye-ozel' ? 'is-active' : '' %>">Kişiye Özel</a>
      <a href="/hakkimizda" class="<%= path === '/hakkimizda' ? 'is-active' : '' %>">Hakkımızda</a>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" aria-label="Ara" aria-expanded="false" aria-controls="site-search" data-search-toggle>
        <%- include('icon', { name: 'search', size: 21 }) %>
      </button>
      <% if (waUrl) { %>
      <a class="btn btn--primary btn--sm header-cta" href="<%= waUrl %>" target="_blank" rel="noopener noreferrer">
        <%- include('icon', { name: 'whatsapp', size: 17 }) %> Sipariş Ver
      </a>
      <% } %>
    </div>
  </div>

  <div class="site-search" id="site-search" hidden data-search>
    <form class="container site-search__form" action="/urunler" method="get" role="search">
      <%- include('icon', { name: 'search', size: 20 }) %>
      <input type="search" name="q" placeholder="Vazo, mumluk, tablo..." aria-label="Ürün ara" maxlength="80">
      <button class="btn btn--primary btn--sm" type="submit">Ara</button>
    </form>
  </div>
</header>

<div class="mobile-nav" id="mobil-menu" hidden data-mobile-nav>
  <div class="mobile-nav__panel">
    <div class="mobile-nav__head">
      <span class="logo__text"><%= settings.site_name %></span>
      <button class="icon-btn" type="button" aria-label="Menüyü kapat" data-nav-close><%- include('icon', { name: 'close', size: 24 }) %></button>
    </div>
    <nav aria-label="Mobil menü">
      <a href="/">Ana Sayfa</a>
      <a href="/urunler">Tüm Ürünler</a>
      <div class="mobile-nav__sub">
        <% navCategories.forEach((c) => { %><a href="/urunler?kategori=<%= c.slug %>"><%= c.name %></a><% }) %>
      </div>
      <a href="/kisiye-ozel">Kişiye Özel Tasarım</a>
      <a href="/hakkimizda">Hakkımızda</a>
    </nav>
    <% if (waUrl) { %>
    <a class="btn btn--primary btn--block" href="<%= waUrl %>" target="_blank" rel="noopener noreferrer"><%- include('icon', { name: 'whatsapp', size: 18 }) %> WhatsApp'tan Yazın</a>
    <% } %>
  </div>
</div>
