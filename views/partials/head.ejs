<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? `${title} · ${settings.site_name}` : `${settings.site_name} · ${settings.tagline}` %></title>
  <meta name="description" content="<%= locals.description || settings.tagline %>">
  <meta name="theme-color" content="#3E4A3D">
  <meta property="og:site_name" content="<%= settings.site_name %>">
  <meta property="og:title" content="<%= locals.title || settings.site_name %>">
  <meta property="og:description" content="<%= locals.description || settings.tagline %>">
  <% if (locals.ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/static/css/site.css">
</head>
<body>
