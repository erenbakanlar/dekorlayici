# Sunucu portu
PORT=3000

# production olduğunda: güvenli (HTTPS) çerez, CSP upgrade-insecure-requests, şablon önbelleği
NODE_ENV=development

# Oturum imza anahtarı — EN AZ 32 karakter, rastgele. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Sitenin gerçek adresi (sitemap, WhatsApp'a giden ürün linkleri için). Örn: https://www.dekorlayici.com
SITE_URL=

# Nginx / Cloudflare gibi bir ters vekil arkasındaysanız 1 yapın (HTTPS algılama ve IP bazlı limitler için)
TRUST_PROXY=
