<%- include('_top') %>

<section class="adm-card adm-narrow">
  <h2 class="adm-card__title">Parolanızı değiştirin</h2>
  <% if (error) { %><div class="adm-alert adm-alert--error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/admin/parola">
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <input type="text" name="username" value="<%= admin.username %>" autocomplete="username" hidden>
    <div class="adm-field"><label for="current">Mevcut parola</label><input id="current" name="current" type="password" required autocomplete="current-password" maxlength="200"></div>
    <div class="adm-field"><label for="password">Yeni parola</label><input id="password" name="password" type="password" required minlength="10" autocomplete="new-password" maxlength="200">
      <small class="muted">En az 10 karakter; harf ve rakam içermeli.</small></div>
    <div class="adm-field"><label for="password2">Yeni parola (tekrar)</label><input id="password2" name="password2" type="password" required minlength="10" autocomplete="new-password" maxlength="200"></div>
    <button class="adm-btn adm-btn--primary" type="submit">Parolayı Güncelle</button>
  </form>
</section>

<%- include('_bottom') %>
